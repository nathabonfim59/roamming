<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nathabonfim59.roamming</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/roamming.app/Contents/MacOS/roamming</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- autostart at login only; a user-quit instance stays quit -->
  <key>KeepAlive</key>
  <false/>
  <!-- GUI login sessions only (not SSH) -->
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
